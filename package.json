{
  "name": "tezup-pos",
  "version": "2.5.0",
  "description": "Tez-Up POS - Professional Restaurant POS System (Offline & Online)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.tezup.pos",
    "productName": "Tez-Up POS",
    "copyright": "Copyright © 2026 Tez-Up POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tez-Up POS"
    },
    "files": [
      "index.html",
      "manifest.json",
      "sw.js",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "main.js",
      "preload.js"
    ]
  },
  "keywords": [
    "pos",
    "restaurant",
    "cashier",
    "offline-pos",
    "electron"
  ],
  "author": "Tez-Up POS Systems",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
